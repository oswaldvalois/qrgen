{
  "name": "QRGen — QR Code Generator",
  "short_name": "QRGen",
  "description": "Ubah teks, link, atau informasi lainnya menjadi QR code dalam hitungan detik. Gratis, mudah, dan bisa digunakan di mana saja.",
  "start_url": "./index.html",
