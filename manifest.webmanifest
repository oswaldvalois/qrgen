    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "os": "android", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
